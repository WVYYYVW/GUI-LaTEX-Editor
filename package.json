{
  "name": "latex-problem-editor",
  "productName": "LaTeX Problem Editor",
  "version": "0.3.1",
  "description": "数学の問題を LaTeX で作成・管理する日本語向けデスクトップアプリ（Windows / macOS）",
  "main": "electron/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/copy-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && node scripts/run-electron.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "dist": "vite build && electron-builder --config electron-builder.config.cjs",
    "dist:win": "vite build && electron-builder --config electron-builder.config.cjs --win",
    "dist:mac": "vite build && electron-builder --config electron-builder.config.cjs --mac"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "js-yaml": "^4.3.2",
    "katex": "^0.19.1",
    "mathlive": "^0.111.4",
    "pdfjs-dist": "^4.10.38",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
